# village-3d on Caddy (Ubuntu package, 2.6). `deploy.sh setup` fills in VILLAGE_DOMAIN, VILLAGE_USER and VILLAGE_HASH.
# Caddy gets and renews the HTTPS certificate on its own once DNS points here and ports 80/443 are open.
VILLAGE_DOMAIN {
	root * /var/www/village-3d
	encode zstd gzip

	# The AI Village dataset is gated (research terms): keep this login until AI Digest agrees to a public site.
	basicauth {
		VILLAGE_USER VILLAGE_HASH
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /data/* Cache-Control "public, max-age=3600"
	@code path / /index.html *.js
	header @code Cache-Control no-cache

	log {
		output file /var/log/caddy/village-access.log
	}
	file_server
}

# village-3d on Caddy (Ubuntu package, 2.6), rendered by deploy.sh:
#   tunnel: plain HTTP on 127.0.0.1:8080 for cloudflared, no login block (Cloudflare does HTTPS, Access does login)
#   setup:  VILLAGE_DOMAIN/USER/HASH filled in; Caddy gets the HTTPS certificate itself once DNS points here
VILLAGE_DOMAIN {
	root * /var/www/village-3d
	encode zstd gzip

	# The AI Village dataset is gated (research terms): keep this login until AI Digest agrees to a public site.
	basicauth {
		VILLAGE_USER VILLAGE_HASH
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /data/* Cache-Control "public, max-age=3600"
	@code path / /index.html *.js
	header @code Cache-Control no-cache

	log {
		output file /var/log/caddy/village-access.log
	}
	file_server
}
